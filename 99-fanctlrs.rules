# Let the wheel group write fan controls (pwmN, pwmN_enable) on any hwmon chip,
# so fanctlrs runs without sudo. Debian/Ubuntu: change "wheel" to "sudo".
ACTION=="add", SUBSYSTEM=="hwmon", RUN+="/bin/sh -c 'for f in /sys%p/pwm[0-9] /sys%p/pwm[0-9]_enable; do [ -e $$f ] && chgrp wheel $$f && chmod g+w $$f; done; true'"
# Let the same group read the CPU energy counters (RAPL), for the CPU power sensors.
# Root-only by default since the PLATYPUS side channel; members of this group can
# become root anyway.
ACTION=="add", SUBSYSTEM=="powercap", RUN+="/bin/sh -c 'f=/sys%p/energy_uj; [ -e $$f ] && chgrp wheel $$f && chmod g+r $$f; true'"
